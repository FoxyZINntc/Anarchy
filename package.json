{
  "name": "anarchy",
  "productName": "Anarchy",
  "version": "1.4.1",
  "description": "Anarchy: chat, grupos, amigos, calls e compartilhamento de tela",
  "author": "Lucas",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/server.js",
    "app": "electron .",
    "dist:win": "npm run nativo && electron-builder --win",
    "dist:cliente": "npm run nativo && electron-builder --win --config electron-builder.cliente.json",
    "nativo": "desktop\\\\native\\\\compilar.cmd"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "compression": "^1.8.1",
    "express": "^4.22.3",
    "selfsigned": "^2.4.1",
    "socket.io": "^4.8.1"
  },
  "build": {
    "appId": "com.discordia.app",
    "productName": "Anarchy",
    "asar": false,
    "files": [
      "desktop/**/*",
      "server/**/*",
      "!server/dados/**",
      "!**/.env",
      "package.json",
      "!desktop/servidor-padrao.json",
      "!desktop/native/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "desktop/build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anarchy",
      "artifactName": "Anarchy Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "desktop/native/somtela.exe",
        "to": "somtela.exe"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "resedit": "^2.0.3"
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
