{
  "name": "discordia",
  "productName": "Discordia",
  "version": "1.1.3",
  "description": "Discordia: chat, grupos, amigos, calls e compartilhamento de tela",
  "author": "Lucas",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/server.js",
    "app": "electron .",
    "dist:win": "electron-builder --win",
    "dist:cliente": "electron-builder --win --config electron-builder.cliente.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "express": "^4.21.2",
    "selfsigned": "^2.4.1",
    "socket.io": "^4.8.1"
  },
  "build": {
    "appId": "com.discordia.app",
    "productName": "Discordia",
    "asar": false,
    "files": [
      "desktop/**/*",
      "server/**/*",
      "!server/dados/**",
      "!**/.env",
      "package.json",
      "!desktop/servidor-padrao.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "desktop/build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Discordia",
      "artifactName": "Discordia Setup.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  }
}