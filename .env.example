# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Nunca envie o .env para o GitHub.
SUPABASE_URL=https://npyvvnqvtpenucqoovza.supabase.co
SUPABASE_ANARCHY_TOKEN=cole-aqui-o-token-do-servidor
# ou, em vez do token: SUPABASE_SERVICE_ROLE_KEY=chave-service_role
PORT=3000

# Endereço público fixo (o instalar.ps1 preenche sozinho com o do Tailscale Funnel)
# PUBLIC_URL=https://seu-servidor.tailXXXX.ts.net

# TURN para as calls funcionarem em 4G/CGNAT (opcional, mas recomendado).
# Cloudflare: dash.cloudflare.com > Realtime > TURN Server > Create (grátis até 1000 GB/mês)
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Ou outro TURN qualquer:
# TURN_URLS=turn:turn.exemplo.com:3478,turns:turn.exemplo.com:5349
# TURN_USER=
# TURN_PASS=

# Email (confirmar o email da conta e "Esqueci a senha"). Sem isso, a recuperação por email fica desligada.
# Gmail: ative a verificação em 2 etapas e crie uma "senha de app" em myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=seuemail@gmail.com
# SMTP_PASS=senha-de-app-de-16-letras
# EMAIL_FROM=Anarchy <seuemail@gmail.com>
