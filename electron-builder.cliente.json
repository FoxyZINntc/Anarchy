{
  "appId": "com.discordia.app",
  "productName": "Anarchy",
  "asar": true,
  "files": [
    "desktop/**/*",
    "package.json",
    "!desktop/servidor-padrao.json",
    "!desktop/build/**",
    "!**/node_modules/**",
    "!desktop/native/**"
  ],
  "extraResources": [
    {
      "from": "desktop/native/somtela.exe",
      "to": "somtela.exe"
    }
  ],
  "directories": {
    "output": "dist-cliente",
    "buildResources": "desktop/assets"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "desktop/build/icon.ico"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Anarchy",
    "artifactName": "Anarchy Setup.${ext}",
    "deleteAppDataOnUninstall": false
  }
}
